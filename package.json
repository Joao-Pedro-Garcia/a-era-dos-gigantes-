{
  "name": "era-dos-gigantes",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs e2e-out",
    "test:combat": "node tests/e2e/combat.mjs e2e-out/combat",
    "shots": "node tests/visual/shots.mjs shots",
    "test:perf": "node tests/perf/bench.mjs e2e-out/perf.json",
    "server": "node server/server.ts",
    "test:load": "node server/loadtest.ts"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/three": "0.170.0",
    "@types/ws": "^8.5.13",
    "fake-indexeddb": "6.0.0",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
